import numpy as np
import matplotlib.pyplot as plt

def rhs(u, p):
    a, c, b, G = p
    f = -u[1] - u[0]*(u[1] + 1) + G
    return np.array([-a*u[0] + c*f + b*u[1], f])

def RK2step(u, h, p):
    k1 = rhs(u, p)
    return u + h*rhs(u + 0.5*h*k1, p)

h = 0.001
nStep = 40000

def simulate(p, u0):
    u = np.array(u0, dtype=float)
    path = [u.copy()]
    controlled = True

    for i in range(nStep):
        u = RK2step(u, h, p)

        if not np.all(np.isfinite(u)) or u[1] < -100:
            controlled = False
            break

        path.append(u.copy())

    return np.array(path), controlled


# Case 1: Constant parameters, varied initial conditions

p = [0.1, 1.0, 1.0, 1.6]  # a, c, b, G

initial_conditions = [
    [0, 0],
    [-2, -0.5],
    [-4, -1],
    [-6, -1.5],
    [-8, -1.8]
]

print("CASE 1: CONSTANT PARAMETERS, VARIED INITIAL CONDITIONS\n")

plt.figure(figsize=(8, 5))

for u0 in initial_conditions:
    path, controlled = simulate(p, u0)

    if controlled:
        result = "controlled over the simulated interval"
    else:
        result = "not controlled"

    print(f"For a={p[0]}, b={p[2]}, c={p[1]}, G={p[3]} "
          f"and initial conditions {u0}, "
          f"the behaviour is {result}.")

    plt.plot(path[:, 0], path[:, 1], label=str(u0))

plt.xlabel("u")
plt.ylabel("v")
plt.title("Case 1: Varied Initial Conditions")
plt.legend()
plt.grid()
plt.tight_layout()
plt.savefig("Q4_case1.pdf")
plt.show()


