import numpy as np
import matplotlib.pyplot as plt

def rhs(u, p):
    a, c, b, G = p
    f = -u[1] - u[0]*(u[1] + 1) + G
    return np.array([-a*u[0] + c*f + b*u[1], f])

def Jac(u, p):
    a, c, b, G = p
    return np.array([
        [-a-c*(u[1]+1), b-c*(u[0]+1)],
        [-u[1]-1, -u[0]-1]
    ])

def RK2step(u, h, p):
    k1 = rhs(u, p)
    return u + h*rhs(u + 0.5*h*k1, p)

def simulate(p, u0):
    u = np.array(u0, dtype=float)
    path = [u.copy()]

    for i in range(nStep):
        u = RK2step(u, h, p)

        if not np.all(np.isfinite(u)):
            return np.array(path), False

        path.append(u.copy())

        if u[1] < -100:
            return np.array(path), False

    return np.array(path), True


h = 0.001
nStep = 40000
a, c, b = 0.1, 1.0, 1.0
Gsn = -(a+b)**2/(4*a*b)

# Each case contains G and all tested initial conditions
cases = [
    (-4.0, [
        [100, 0], [0, 100], [-100, 0], [0, -100]
    ]),
    (Gsn, [
        [-6, -1.5], [-5.5, 0], [-4, 0], [-7, -1]
    ]),
    (1.6, [
        [-8, -1.8], [-6, -0.5], [-7, -0.5],
        [-5, -0.5], [-6, -2], [-6, 0.5],
        [-7, -1.5], [-5, -1.5]
    ])
]

print(f"Saddle-node value: G_SN = {Gsn:.3f}")

for case, (G, initial_conditions) in enumerate(cases, 1):
    p = [a, c, b, G]
    D = (a+b)**2 + 4*a*b*G
    equilibria = []

    print(f"\nCASE {case}: G = {G:.3f}")

    if D < -1e-12:
        print("No real equilibria.")
    else:
        signs = [1, -1] if D > 1e-12 else [1]

        for sign in signs:
            v = (-(a+b) + sign*np.sqrt(max(D, 0)))/(2*b)
            eq = np.array([b*v/a, v])
            eig = np.linalg.eigvals(Jac(eq, p))
            equilibria.append((eq, eig))

            print(f"Equilibrium: {eq.round(3)}, "
                  f"eigenvalues: {eig.round(3)}")

    plt.figure(figsize=(8, 5))

    for u0 in initial_conditions:
        path, bounded = simulate(p, u0)

        controlled = any(
            np.linalg.norm(path[-1] - eq) < 0.01
            and np.all(np.real(eig) < -1e-6)
            for eq, eig in equilibria
        )

        if controlled:
            result = "Controlled"
        elif not bounded:
            result = "Uncontrolled"
        else:
            result = "Inconclusive"

        print(f"Initial conditions {u0}: {result}")

        plt.plot(path[:, 0], path[:, 1], label=str(u0))

    for eq, eig in equilibria:
        plt.plot(eq[0], eq[1], 'k*', markersize=11)

    plt.xlabel("u")
    plt.ylabel("v")
    plt.title(f"Case {case}: G = {G:.3f}")
    plt.grid()
    plt.legend(fontsize=8)

    if case == 1:
        plt.xlim(-100, 100)
        plt.ylim(-100, 100)
    elif case == 2:
        plt.xlim(-10, 0)
        plt.ylim(-5, 5)
    else:
        plt.xlim(-15, 10)
        plt.ylim(-10, 5)

    plt.tight_layout()
    plt.savefig(f"Q4_case{case}.pdf")
    plt.show()


print("\nCONCLUSIONS")

print(f"\nFor a={a}, b={b}, c={c}, and G < {Gsn:.3f}, "
      "no real equilibrium exists, so the model cannot "
      "be controlled by convergence to an equilibrium.")

print("\nFor a=0.1, b=1.0, c=1.0, G=1.6 and "
      "initial conditions (-6,-0.5), the behaviour "
      "is controlled by convergence to a stable equilibrium.")

print("\nFor the same parameters and initial conditions "
      "(-8,-1.8), the behaviour is uncontrolled.")

print("\nTherefore, the numerical experiments suggest that "
      "controllability depends on both the parameter G "
      "and the initial conditions.")
