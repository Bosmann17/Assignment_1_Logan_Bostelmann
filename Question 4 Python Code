import numpy as np
import matplotlib.pyplot as plt

def rhs(u, p):
    a, c, b, G = p
    f = -u[1] - u[0]*(u[1] + 1) + G
    return np.array([-a*u[0] + c*f + b*u[1], f])

def Jac(u, p):
    a, c, b, G = p
    return np.array([
        [-a-c*(u[1]+1), b-c*(u[0]+1)],
        [-u[1]-1, -u[0]-1]
    ])

def RK2step(u, h, p):
    return u + h*rhs(u + 0.5*h*rhs(u, p), p)

def simulate(p, u0):
    u = np.array(u0, dtype=float)
    path = [u.copy()]

    for _ in range(nStep):
        with np.errstate(over="ignore", invalid="ignore"):
            next_u = RK2step(u, h, p)

        if not np.all(np.isfinite(next_u)):
            return np.array(path), False

        u = next_u
        path.append(u.copy())

        if u[1] < -100:
            return np.array(path), False

    return np.array(path), True


h = 0.001
nStep = 40000
a, c, b = 0.2, 1.2, 0.8
Gsn = -(a+b)**2/(4*a*b)

cases = [
    (-2.0, [
        [20, 0], [0, 20], [-20, 0], [0, -20]
    ]),
    (Gsn, [
        [-3, -1.2], [-2.5, 0], [-1.5, 0], [-4, -0.8]
    ]),
    (1.4, [
        [-5, -1.5], [-3, -0.4], [-4, -0.4],
        [-2, -0.4], [-3, -1.8], [-3, 0.6],
        [-4, -1.2], [-2, -1.2]
    ])
]

print(f"Saddle-node value: G_SN = {Gsn:.4f}")

for case, (G, initial_conditions) in enumerate(cases, 1):
    p = [a, c, b, G]
    D = (a+b)**2 + 4*a*b*G
    equilibria = []

    print(f"\nCASE {case}: G = {G:.4f}")

    if D < -1e-12:
        print("No real equilibria.")
    else:
        signs = [1, -1] if D > 1e-12 else [1]

        for sign in signs:
            v = (-(a+b) + sign*np.sqrt(max(D, 0)))/(2*b)
            eq = np.array([b*v/a, v])
            eig, vec = np.linalg.eig(Jac(eq, p))
            equilibria.append((eq, eig, vec))

            print(f"Equilibrium: {eq.round(3)}, "
                  f"eigenvalues: {eig.round(3)}")

    fig, ax = plt.subplots(figsize=(8, 5))

    for u0 in initial_conditions:
        path, bounded = simulate(p, u0)

        controlled = any(
            np.linalg.norm(path[-1] - eq) < 0.01
            and np.all(np.real(eig) < -1e-6)
            for eq, eig, vec in equilibria
        )

        if controlled:
            result = "Controlled"
        elif not bounded:
            result = "Uncontrolled"
        else:
            result = "Inconclusive"

        print(f"Initial conditions {u0}: {result}")
        ax.plot(path[:, 0], path[:, 1], label=str(u0))

    # Plot equilibria and eigenvectors
    for eq, eig, vec in equilibria:
        ax.plot(eq[0], eq[1], 'k*', markersize=11)

        for j in range(2):
            if abs(np.imag(eig[j])) > 1e-8:
                continue

            direction = np.real(vec[:, j])
            color = (
                'g' if np.real(eig[j]) < -1e-8
                else 'r' if np.real(eig[j]) > 1e-8
                else 'gray'
            )

            ax.plot(
                [eq[0]-direction[0], eq[0]+direction[0]],
                [eq[1]-direction[1], eq[1]+direction[1]],
                color=color, linewidth=2
            )

    ax.set_xlabel("u")
    ax.set_ylabel("v")
    ax.set_title(f"Case {case}: G = {G:.4f}")
    ax.grid(True)
    ax.legend(fontsize=8)

    # Scaling similar to the original graphs
    if case == 1:
        ax.set_xlim(-25, 25)
        ax.set_ylim(-25, 25)
    elif case == 2:
        ax.set_xlim(-8, 2)
        ax.set_ylim(-5, 5)
    else:
        ax.set_xlim(-12, 8)
        ax.set_ylim(-8, 5)

    fig.tight_layout()
    fig.savefig(f"Q4_case{case}.pdf", format="pdf")
    plt.show()
    plt.close(fig)


print("\nCONCLUSIONS")

print(f"\nFor a={a}, b={b}, c={c}, and G < {Gsn:.4f}, "
      "the model has no real equilibrium and cannot "
      "be controlled by convergence to an equilibrium.")

print("\nFor G > G_SN, the model may have a stable equilibrium, "
      "but controllability also depends on initial conditions.")

print("\nGreen eigenvectors represent stable directions, "
      "red eigenvectors represent unstable directions, "
      "and gray represents a zero eigenvalue.")

print("\nThese conclusions are based on numerical experiments "
      "over 0 <= t <= 40.")
