# Conclusions

print("\nCONCLUSIONS\n")

a, c, b = 0.1, 1.0, 1.0
Gsn = -(a + b)**2 / (4*a*b)

print(f"For a={a}, b={b}, c={c}, G < {Gsn:.3f}, "
      "the model has no real equilibrium and cannot "
      "be controlled by convergence to an equilibrium.")

