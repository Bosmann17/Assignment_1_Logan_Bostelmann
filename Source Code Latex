\small
\begin{tabular}{|c|c|p{8.1cm}|}
\hline
\multicolumn{3}{|c|}{\textbf{Equilibrium Solutions as a Result of \(G\)}}\\
\hline
\textbf{Value of \(G\)} & \textbf{Number of Solutions} &
\centering\arraybackslash\textbf{Equilibrium Solution(s)}\\
\hline
\(G<G_{\mathrm{SN}}\) & Zero & N/a\\
\hline
\(G=G_{\mathrm{SN}}\) & One &
\(\displaystyle (u^*,v^*)=\left(\frac ba v^*,-\frac12\left(1+\frac ab\right)\right)\)\\
\hline
\(G>G_{\mathrm{SN}}\) & Two &
\(\displaystyle
(u^*,v^*)=\left(\frac{b}{a}v^*,\,
